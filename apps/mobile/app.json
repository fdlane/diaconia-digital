{
  "expo": {
    "name": "Diaconia Mobile",
    "slug": "diaconia-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "diaconiamobile",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "py.org.diaconia.mobile",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "py.org.diaconia.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2e3192"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Diaconia usa fotos para perfiles y evidencia de reuniones.",
          "cameraPermission": "Diaconia usa la camara para capturar perfiles y fotos de reuniones."
        }
      ]
    ]
  }
}
